# Copy to .env (or set these in your hosting dashboard)
NODE_ENV=production
PORT=3000
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# First admin login (only used the very first time the server starts)
ADMIN_EMAIL=admin@yourdomain.in
ADMIN_PASSWORD=ChangeThis@123
ADMIN_PHONE=9000000000
# Set to 1 when running behind a reverse proxy / load balancer (Render, Railway, Nginx)
TRUST_PROXY=1
# Where the database and uploaded files are stored
DATA_DIR=./data
# Set to 1 only on a test server to load demo accounts and tutors
SEED_DEMO=0
# Key used to encrypt passwords/API secrets saved in Admin → Config (keep it safe; changing it means re-entering them)
SETTINGS_KEY=change-me-too
# Optional: if the app is opened from a different domain than the server (e.g. a separate web front end), allow it for live connections
# APP_ORIGIN=https://edvitta.in
# Set to 1 to turn off the built-in daily/weekly jobs (auto-reschedule, weekly payouts) when running several app servers
# DISABLE_JOBS=0
